# The container is read back to front and both magic numbers are checked, so
# a dictionary is what gets past the header at all.
container_magic="\xd9\x7d\x20\x21"
mesh_magic="\x4d\x7f\xa0\xc8"
container_version="\x01\x00\x00\x00"
version_3="\x03\x00"
version_4="\x04\x00"
version_5="\x05\x00"
version_6="\x06\x00"
version_7="\x07\x00"
version_8="\x08\x00"
"attr_pos"
"attr_norm"
"attr_uv0"
"attr_uv1"
"attr_textan"
"attr_binormal"
"attr_joints"
"attr_weights"
"attr_colors"
"attr_tpos0"
"attr_tnorm0"
"attr_unsupported"
