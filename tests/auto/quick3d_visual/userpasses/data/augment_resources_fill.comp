// Producer for the augment-shader resource test. Writes one known texel and
// one known vec4 that augment_resources_augment.glsl then reads back.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

STORAGE_BUFFER(fillBuffer, "writeonly") {
    vec4 values[];
}

SHADER_IMAGE("rgba8", fillImage, image2D, "writeonly");

void main()
{
    imageStore(fillImage, ivec2(0, 0), vec4(0.0, 1.0, 0.0, 1.0));
    values[0] = vec4(0.25, 0.5, 0.75, 1.0);
}
