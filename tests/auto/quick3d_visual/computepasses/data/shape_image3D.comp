// Writes a texel of an image3D and reads it back; see shape.qml.

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

SHADER_IMAGE("r32f", shapedImage, image3D, "");
SHADER_IMAGE("rgba8", targetImage, image2D, "writeonly");

void main() {
    ivec2 size = imageSize(targetImage);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    const ivec3 texel = ivec3(1, 2, 3);
    imageStore(shapedImage, texel, vec4(0.5));
    bool ok = abs(imageLoad(shapedImage, texel).r - 0.5) < 0.01;
    imageStore(targetImage, coord, ok ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0));
}
