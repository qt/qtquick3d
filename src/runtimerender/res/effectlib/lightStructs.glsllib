#ifndef LIGHTS_STRUCTS_GLSLLIB
#define LIGHTS_STRUCTS_GLSLLIB

// This contains data for point and spot lights
struct LightData {
    vec3 position;
    float coneAngle;

    vec3 direction;
    float innerConeAngle;

    vec3 diffuseColor;
    float constantAttenuation;

    vec3 specularColor;
    float linearAttenuation;

    uint lightmapState;
    uint pcfSamples;
    float quadraticAttenuation;
    float shadowTextureSize;

    vec2 shadowAtlasUV0;
    vec2 shadowAtlasUV1;

    float shadowAtlasLayer0;
    float shadowAtlasLayer1;
    float pcfFactor;
    float enableShadows;

    float shadowBias;
    float shadowFactor;
    float clipNear;
    float shadowMapFar;

    mat4 shadowMatrix;
}; // 192 bytes (12 x vec4)

struct DirectionalLightData {
    vec3 direction;
    float shadowBias;

    vec3 diffuseColor;
    float shadowFactor;

    vec3 specularColor;
    float enableShadows;

    mat4 matrices[4]; // (4 x 4 vec4)

    vec4 dimensionsInverted[4]; // (x, y, z, 0) 4 vec4

    vec4 csmSplits;

    vec4 csmActive;

    vec4 atlasLocations[4];     // (u, v, size, layer) 4 vec4

    uint lightmapState;
    uint pcfSamples;
    uint csmNumSplits;
    float pcfFactor;

    float shadowMapFar;
    float csmBlendRatio;
    // padding[2]

}; // 496 bytes (31 x vec4)

struct ShadowResult {
    float illumination; // 0.0 = fully occluded, 1.0 = fully visible
    bool isLit; // is the fragment hit by any direct light (used for specular computation)
};

#endif
